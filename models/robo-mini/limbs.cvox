// Right-side limbs: arm-r / leg-r are the left side mirrored across x.

part arm-r
    size 2 3 1
    pivot 1 3 0
    voxels {
        .1
        ,
        .0
        ,
        00
    }

part leg-l
    size 2 2 1
    pivot 1 2 0
    voxels {
        33
        ,
        00
    }

part leg-r
    size 2 2 1
    pivot 1 2 0
    voxels {
        33
        ,
        00
    }
