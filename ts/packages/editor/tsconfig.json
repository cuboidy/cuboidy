{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    // `.` rather than `src` so test/ and e2e/ typecheck too. The package
    // never emits (noEmit below), so rootDir only scopes what tsc will
    // accept.
    "rootDir": ".",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "noEmit": true,
    "allowImportingTsExtensions": false
  },
  // e2e/ included for the same reason the workspace's is: an unresolved
  // name in a spec should cost two seconds of tsc, not a browser run.
  "include": ["src/**/*", "test/**/*", "e2e/**/*"]
}
