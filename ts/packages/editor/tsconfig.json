{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No `outDir` / `rootDir`: it constrains emit layout, this package never emits,
    // and setting it would reject the core sources the `paths` mapping
    // above deliberately pulls in from a sibling directory.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "noEmit": true,
    "allowImportingTsExtensions": false
  },
  // e2e/ included for the same reason the workspace's is: an unresolved
  // name in a spec should cost two seconds of tsc, not a browser run.
  "include": ["src/**/*", "test/**/*", "e2e/**/*"]
}
