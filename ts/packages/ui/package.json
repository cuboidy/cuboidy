    "./base.css": "./src/base.css",
    "./dock.css": "./src/dock.css",
    "./chrome.css": "./src/chrome.css",
    "./tree.css": "./src/tree.css",
    "./fields.css": "./src/fields.css",
    "./transport.css": "./src/transport.css",
    "./viewport.css": "./src/viewport.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cuboidy/core": "*",
    "lucide-react": "^1.24.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^6.0.3"
  }
}
