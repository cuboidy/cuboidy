{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    // `.` rather than `src` so test/ and e2e/ typecheck too. The package
    // never emits (noEmit below), so rootDir only scopes what tsc will
    // accept.
    "rootDir": ".",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "noEmit": true,
    "allowImportingTsExtensions": false
  },
  // e2e/ included: a spec that referenced an undeleted helper typechecked
  // and linted clean, then failed 80 seconds into a browser run. Two
  // seconds of tsc is the right place to find that.
  "include": ["src/**/*", "test/**/*", "e2e/**/*"]
}
