{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    // `.` rather than `src` so test/ typechecks too. The package never
    // emits (noEmit below), so rootDir only scopes what tsc will accept.
    "rootDir": ".",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "noEmit": true,
    "allowImportingTsExtensions": false
  },
  "include": ["src/**/*", "test/**/*"]
}
