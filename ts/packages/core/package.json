{
  "name": "@cuboidy/core",
  "version": "0.0.0",
  "description": "Cuboidy reference implementation (TypeScript): parser, canonical serializer, manifest validation, shared project loader, lint, and inspection CLIs (view/query/snap).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "cuboidy-lint": "./dist/cli/cuboidy-lint.js",
    "cuboidy-view": "./dist/cli/cuboidy-view.js",
    "cuboidy-query": "./dist/cli/cuboidy-query.js",
    "cuboidy-snap": "./dist/cli/cuboidy-snap.js",
    "cuboidy-part": "./dist/cli/cuboidy-part.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:schema": "tsx scripts/generate-schema.ts",
    "lint": "tsx src/cli/cuboidy-lint.ts",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
