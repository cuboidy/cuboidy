{
  "name": "@cuboidy/three",
  "version": "0.9.0",
  "description": "three.js for Cuboidy models: voxel geometry, SPEC §7.4 materials, back-to-front ordering, the rig that places the parts, the studio lighting, and one Object3D for a whole package",
  "license": "MIT",
  "keywords": [
    "cuboidy",
    "voxel",
    "three",
    "threejs",
    "rig",
    "animation",
    "webgl"
  ],
  "homepage": "https://github.com/cuboidy/cuboidy/tree/main/ts/packages/three#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuboidy/cuboidy.git",
    "directory": "ts/packages/three"
  },
  "bugs": {
    "url": "https://github.com/cuboidy/cuboidy/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "dist/browser/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && npm run bundle",
    "bundle": "node scripts/bundle.mjs",
    "prepare": "node scripts/prepare.mjs",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@cuboidy/core": "^0.9.0"
  },
  "peerDependencies": {
    "three": ">=0.160.0 <1.0.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "esbuild": "^0.25.10",
    "three": "^0.170.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
