{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuboidy.com/schema/cuboidy.schema.json",
  "title": "Cuboidy Manifest",
  "description": "Schema for cuboidy.json — the manifest file of a Cuboidy v0.9 model package (geometry list, palette binding, rig hierarchy + animation references). Generated from the Zod ManifestSchema in @cuboidy/core. SPEC §8 reference paths, tuple arity and geometry uniqueness are encoded; the remaining runtime-only rules (SPEC §11.5: duplicate part names, parent existence/cycles, animation duration/time-key semantics) need parseManifest or an equivalent validator.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]*$",
      "not": {
        "enum": [
          "palette",
          "part",
          "size",
          "pivot",
          "socket",
          "voxels",
          "rot"
        ]
      }
    },
    "version": {
      "type": "string"
    },
    "geometry": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*//)[^\\\\:]+\\.json$"
      },
      "uniqueItems": true
    },
    "palette": {
      "anyOf": [
        {
          "minItems": 1,
          "maxItems": 62,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
              },
              {
                "type": "object",
                "properties": {
                  "color": {
                    "type": "string",
                    "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                  },
                  "metallic": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "roughness": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "emissive": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "color"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        {
          "type": "string",
          "pattern": "^(?!/)(?!.*//)[^\\\\:]+\\.json$"
        }
      ]
    },
    "parts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]*$",
            "not": {
              "enum": [
                "palette",
                "part",
                "size",
                "pivot",
                "socket",
                "voxels",
                "rot"
              ]
            }
          },
          "parent": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]*$",
            "not": {
              "enum": [
                "palette",
                "part",
                "size",
                "pivot",
                "socket",
                "voxels",
                "rot"
              ]
            }
          },
          "position": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "minItems": 3,
            "maxItems": 3
          },
          "rotation": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "minItems": 3,
            "maxItems": 3
          },
          "geometry": {
            "type": "object",
            "properties": {
              "size": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1024
                  },
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1024
                  },
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1024
                  }
                ],
                "minItems": 3,
                "maxItems": 3
              },
              "pivot": {
                "type": "object",
                "properties": {
                  "pos": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "rot": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "minItems": 3,
                    "maxItems": 3
                  }
                },
                "required": [
                  "pos"
                ],
                "additionalProperties": false
              },
              "sockets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]*$",
                      "not": {
                        "enum": [
                          "palette",
                          "part",
                          "size",
                          "pivot",
                          "socket",
                          "voxels",
                          "rot"
                        ]
                      }
                    },
                    "pos": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        }
                      ],
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "rot": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        }
                      ],
                      "minItems": 3,
                      "maxItems": 3
                    }
                  },
                  "required": [
                    "name",
                    "pos"
                  ],
                  "additionalProperties": false
                }
              },
              "voxels": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[.0-9a-zA-Z]*$"
                  }
                }
              },
              "palette": {
                "anyOf": [
                  {
                    "minItems": 1,
                    "maxItems": 62,
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "color": {
                              "type": "string",
                              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                            },
                            "metallic": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "roughness": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "emissive": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          },
                          "required": [
                            "color"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*//)[^\\\\:]+\\.json$"
                  }
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*//)[^\\\\:]+\\.json$"
              },
              "part": {
                "type": "string",
                "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]*$",
                "not": {
                  "enum": [
                    "palette",
                    "part",
                    "size",
                    "pivot",
                    "socket",
                    "voxels",
                    "rot"
                  ]
                }
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "sockets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]*$",
        "not": {
          "enum": [
            "palette",
            "part",
            "size",
            "pivot",
            "socket",
            "voxels",
            "rot"
          ]
        }
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "part": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]*$",
            "not": {
              "enum": [
                "palette",
                "part",
                "size",
                "pivot",
                "socket",
                "voxels",
                "rot"
              ]
            }
          },
          "socket": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]*$",
            "not": {
              "enum": [
                "palette",
                "part",
                "size",
                "pivot",
                "socket",
                "voxels",
                "rot"
              ]
            }
          }
        },
        "required": [
          "part",
          "socket"
        ],
        "additionalProperties": false
      }
    },
    "animations": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]*$",
        "not": {
          "enum": [
            "palette",
            "part",
            "size",
            "pivot",
            "socket",
            "voxels",
            "rot"
          ]
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "duration": {
                "type": "number"
              },
              "loop": {
                "type": "boolean"
              },
              "parts": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "rot": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "minItems": 3,
                        "maxItems": 3
                      },
                      "pos": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "minItems": 3,
                        "maxItems": 3
                      },
                      "scale": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "minItems": 3,
                        "maxItems": 3
                      },
                      "visible": {
                        "type": "boolean"
                      },
                      "ease": {
                        "type": "object",
                        "properties": {
                          "rot": {
                            "type": "string",
                            "enum": [
                              "linear",
                              "step",
                              "in-sine",
                              "out-sine",
                              "in-out-sine",
                              "in-quad",
                              "out-quad",
                              "in-out-quad",
                              "in-cubic",
                              "out-cubic",
                              "in-out-cubic",
                              "in-back",
                              "out-back",
                              "in-out-back",
                              "in-elastic",
                              "out-elastic",
                              "in-out-elastic",
                              "in-bounce",
                              "out-bounce",
                              "in-out-bounce"
                            ]
                          },
                          "pos": {
                            "type": "string",
                            "enum": [
                              "linear",
                              "step",
                              "in-sine",
                              "out-sine",
                              "in-out-sine",
                              "in-quad",
                              "out-quad",
                              "in-out-quad",
                              "in-cubic",
                              "out-cubic",
                              "in-out-cubic",
                              "in-back",
                              "out-back",
                              "in-out-back",
                              "in-elastic",
                              "out-elastic",
                              "in-out-elastic",
                              "in-bounce",
                              "out-bounce",
                              "in-out-bounce"
                            ]
                          },
                          "scale": {
                            "type": "string",
                            "enum": [
                              "linear",
                              "step",
                              "in-sine",
                              "out-sine",
                              "in-out-sine",
                              "in-quad",
                              "out-quad",
                              "in-out-quad",
                              "in-cubic",
                              "out-cubic",
                              "in-out-cubic",
                              "in-back",
                              "out-back",
                              "in-out-back",
                              "in-elastic",
                              "out-elastic",
                              "in-out-elastic",
                              "in-bounce",
                              "out-bounce",
                              "in-out-bounce"
                            ]
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "additionalProperties": false
                  }
                }
              }
            },
            "required": [
              "duration",
              "loop",
              "parts"
            ],
            "additionalProperties": false
          },
          {
            "type": "string",
            "pattern": "^(?!/)(?!.*//)[^\\\\:]+\\.json$"
          }
        ]
      }
    }
  },
  "required": [
    "name",
    "parts"
  ],
  "additionalProperties": false
}
