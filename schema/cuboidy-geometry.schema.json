{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuboidy.com/schema/cuboidy-geometry.schema.json",
  "title": "Cuboidy Geometry",
  "description": "Schema for voxels.json — the voxel definition of a Cuboidy v0.9 model package (palette, parts, pivots, sockets, voxel grids). Generated from the Zod GeometrySchema in @cuboidy/core. Field shapes, size bounds, the voxel-row alphabet and identifier rules are encoded; the cross-field rules need parseGeometry or an equivalent validator, because they read more than one value at a time (SPEC §7.9 layer/row/width agreement with `size`, §7.4 palette index range, §7.8 socket-name uniqueness).",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "palette": {
      "anyOf": [
        {
          "minItems": 1,
          "maxItems": 62,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
          }
        },
        {
          "type": "string",
          "pattern": "^(?!/)(?!.*//)[^\\\\:]+\\.json$"
        }
      ]
    },
    "parts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]*$",
            "not": {
              "enum": [
                "palette",
                "part",
                "size",
                "pivot",
                "socket",
                "voxels",
                "rot"
              ]
            }
          },
          "size": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 1024
              },
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 1024
              },
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 1024
              }
            ],
            "minItems": 3,
            "maxItems": 3
          },
          "pivot": {
            "type": "object",
            "properties": {
              "pos": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 3,
                "maxItems": 3
              },
              "rot": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": [
              "pos"
            ],
            "additionalProperties": false
          },
          "sockets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]*$",
                  "not": {
                    "enum": [
                      "palette",
                      "part",
                      "size",
                      "pivot",
                      "socket",
                      "voxels",
                      "rot"
                    ]
                  }
                },
                "pos": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "minItems": 3,
                  "maxItems": 3
                },
                "rot": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "minItems": 3,
                  "maxItems": 3
                }
              },
              "required": [
                "name",
                "pos"
              ],
              "additionalProperties": false
            }
          },
          "voxels": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[.0-9a-zA-Z]*$"
              }
            }
          }
        },
        "required": [
          "name",
          "size",
          "voxels"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "parts"
  ],
  "additionalProperties": false
}
